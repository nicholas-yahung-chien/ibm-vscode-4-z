{"_id":"wontache","_rev":"3-f561bc8dae9d944b9223f985e2e1c543","name":"wontache","dist-tags":{"latest":"0.2.0"},"versions":{"0.0.1":{"name":"wontache","version":"0.0.1","description":"Compact, spec-compliant Mustache implementation with extras","keywords":["hogan","inheritance","lambda","mustache","partial","render","template","templating","view"],"author":{"name":"Julian Gonggrijp","url":"https://juliangonggrijp.com"},"license":"BSD-3-Clause","homepage":"https://jgonggrijp.gitlab.io/wontache/","bugs":{"url":"https://gitlab.com/jgonggrijp/wontache/issues"},"repository":{"type":"git","url":"https://gitlab.com/jgonggrijp/wontache.git","directory":"mustache"},"main":"mustache-umd.js","module":"module.js","type":"commonjs","exports":{".":{"import":{"module":"./module.js","node":"./mustache-node.mjs","default":"./mustache-esm.js"},"default":"./mustache-umd.js"},"./customUnderscore":"./customUnderscore/index.js","./customUnderscore/*":"./customUnderscore/*","./package.json":"./package.json"},"scripts":{"build":"runcoffee rollup.coffee","prepare":"yarn build","pretest":"runcoffee test-util/compile-template.coffee","test":"mocha --package ../package.json --delay"},"dependencies":{"underscore":"^1.13.0-2"},"devDependencies":{"@babel/core":"^7.13.8","@babel/preset-env":"^7.13.9","@rollup/plugin-alias":"^3.1.2","@rollup/plugin-babel":"^5.3.0","@rollup/plugin-commonjs":"^17.1.0","@rollup/plugin-node-resolve":"^11.2.0","async":"^3.2.0","coffeescript":"^2.6.1","mocha":"^9.1.3","rollup":"^2.39.1","rollup-plugin-coffee-script":"^2.0.0","wontache-devtools-runcoffee":"0","yaml":"^1.10.0"},"_id":"wontache@0.0.1","dist":{"shasum":"985e30988b14dcaae8e459daab5b71c30b659e86","integrity":"sha512-/eF0LNVJRAD8ubRGNnkGXZYcw6md4SmO57M734z3ckO1SNBu25ap02UNyVbM3eRqjJGwyX0+6Vo9sIyTYL81yg==","tarball":"https://registry.npmjs.org/wontache/-/wontache-0.0.1.tgz","fileCount":15,"unpackedSize":242166,"npm-signature":"-----BEGIN PGP SIGNATURE-----\r\nVersion: OpenPGP.js v3.0.13\r\nComment: https://openpg